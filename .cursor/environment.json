{
  "name": "Think Box AI",
  // Box remote execution: set Cursor Environment secrets (exact names, not in git):
  // UPSTASH_PUBLIC_BOX_URL, UPSTASH_PUBLIC_BOX_TOKEN — see docs/guides/upstash_box_access_verification.md
  "install": "pip install -e \".[dev]\" && (cd apps/web && npm install)",
  "terminals": [
    {
      "name": "api",
      "command": "python3 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000"
    },
    {
      "name": "web",
      "command": "cd apps/web && npm start"
    }
  ]
}
