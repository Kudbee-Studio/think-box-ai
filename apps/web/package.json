{
  "name": "thinkbox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node launch.mjs server",
    "start": "node launch.mjs server",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "tsgo --noEmit --noUnusedLocals",
    "test": "node --experimental-strip-types --no-warnings --test --test-timeout=30000 --test-reporter=spec \"tests/*.test.ts\"",
    "test:coverage": "c8 --all --include='*.ts' --include='routes/*.ts' --exclude='tests/**' --exclude='routes/types.ts' --exclude='**/*.d.ts' --exclude='vitest.config.ts' --reporter=text --reporter=json-summary --report-dir=.coverage node --experimental-strip-types --no-warnings --test --test-timeout=60000 \"tests/*.test.ts\"",
    "gates": "node --experimental-strip-types --no-warnings tests/e2e/gates.ts",
    "test:e2e": "node --experimental-strip-types --no-warnings tests/e2e/dashboard-live.e2e.ts",
    "test:live-lookup": "node --experimental-strip-types --no-warnings tests/e2e/live-lookup.live.ts",
    "test:live-local-tools": "node --experimental-strip-types --no-warnings tests/e2e/local-tools.live.ts",
    "test:e2e:convoy": "node --experimental-strip-types --no-warnings tests/e2e/convoy-live.e2e.ts",
    "test:live-acceptance": "node --experimental-strip-types --no-warnings tests/e2e/acceptance.live.ts",
    "test:e2e:convoy-real": "node --experimental-strip-types --no-warnings tests/e2e/convoy-real.e2e.ts",
    "test:live-observe": "node --experimental-strip-types --no-warnings tests/e2e/observe-live.ts",
    "test:live-eval": "node --experimental-strip-types --no-warnings tests/e2e/local-eval.live.ts",
    "test:live-token-ab": "node --experimental-strip-types --no-warnings tests/e2e/local-token-ab.live.ts",
    "test:live-token-ab3": "node --experimental-strip-types --no-warnings tests/e2e/token-ab.live.ts",
    "test:live-repo-harvest": "node --experimental-strip-types --no-warnings tests/e2e/repo-token-harvest.live.ts",
    "test:live-repo-escalation": "node --experimental-strip-types --no-warnings tests/e2e/repo-escalation.live.ts",
    "test:live-repo-escalation-report": "node --experimental-strip-types --no-warnings tests/e2e/repo-escalation-report.ts",
    "test:live-token-learning": "node --experimental-strip-types --no-warnings tests/e2e/token-learning.live.ts",
    "test:live-token-learning-report": "node --experimental-strip-types --no-warnings tests/e2e/token-learning-report.ts",
    "test:live-token-learning2": "node --experimental-strip-types --no-warnings tests/e2e/token-learning2.live.ts",
    "test:live-token-learning2-report": "node --experimental-strip-types --no-warnings tests/e2e/token-learning2-report.ts",
    "test:live-token-learning3": "node --experimental-strip-types --no-warnings tests/e2e/token-learning3.live.ts",
    "test:live-token-learning3-report": "node --experimental-strip-types --no-warnings tests/e2e/token-learning3-report.ts",
    "test:e2e:escalation-convoy": "LD_LIBRARY_PATH=$HOME/tools/chromelibs/usr/lib/x86_64-linux-gnu node --experimental-strip-types --no-warnings tests/e2e/escalation-convoy.live.e2e.ts",
    "test:live-true-counts": "node --experimental-strip-types --no-warnings tests/e2e/true-counts.live.ts",
    "test:live-scratch": "node --experimental-strip-types --no-warnings tests/e2e/scratch-runner.live.ts",
    "test:live-repo-recovery": "node --experimental-strip-types --no-warnings tests/e2e/repo-recovery.live.ts",
    "test:e2e:gemma-route": "LD_LIBRARY_PATH=$HOME/tools/chromelibs/usr/lib/x86_64-linux-gnu node --experimental-strip-types --no-warnings tests/e2e/gemma-route-live.e2e.ts",
    "test:live-grounding-audit-replay": "node --experimental-strip-types --no-warnings tests/e2e/grounding-audit-replay.ts",
    "test:live-grounding-audit": "node --experimental-strip-types --no-warnings tests/e2e/grounding-audit.live.ts",
    "export-routing-table": "node --experimental-strip-types --no-warnings tests/e2e/routing-table-export.ts",
    "test:live-token-ab3-report": "node --experimental-strip-types --no-warnings tests/e2e/token-ab-report.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "algosdk": "^3.8.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "multer": "^2.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/ui": "^5.0.3",
    "c8": "^10.1.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
