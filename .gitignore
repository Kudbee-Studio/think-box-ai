# SSH keys - NEVER commit
kilo-upcloud*
*.pem
*.key
id_rsa*
id_ed25519*

# Generated by the web tests / default LearningStore path; never commit
apps/web/learning.db*
apps/web/think-tokens.db*

# Local Neon CLI context; never commit
.neon

# Agent worktrees (may duplicate dependency pins); not part of the product tree
.kilo/worktrees/

# SQLite sidecar files from opening evidence seeds
docs/evidence/**/*.db-shm
docs/evidence/**/*.db-wal
docs/evidence/**/*.bak-pre-*

