# THINK BOX AI — Environment Configuration

# Model Provider: "ollama" or "openai_compat"
# For local: ollama. For cloud: openai_compat (works with OpenAI, Groq, etc.)
THINKBOX_DEFAULT_PROVIDER=ollama

# Ollama Settings (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible Settings (if using openai_compat provider)
# Works with: OpenAI, Groq, Together, vLLM, etc.
# Do NOT use Inception from cloud/box — their CDN rejects SNI from AWS IPs
# THINKBOX_DEFAULT_PROVIDER=openai_compat
# THINKBOX_OPENAI_COMPAT_API_KEY=sk-...
# THINKBOX_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# THINKBOX_DEFAULT_MODEL=gpt-4o-mini

# Groq (fast, free tier available)
# THINKBOX_DEFAULT_PROVIDER=openai_compat
# THINKBOX_OPENAI_COMPAT_API_KEY=gsk_...
# THINKBOX_OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# THINKBOX_DEFAULT_MODEL=llama-3.1-8b-instant

# Memory
THINKBOX_MEMORY_DB_PATH=./thinkbox_memory.db

# Server
THINKBOX_PROJECT_ROOT=.
