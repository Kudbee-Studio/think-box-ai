# THINK BOX AI — Environment Configuration

# Model Provider: "ollama" or "openai_compat"
# For local: ollama. For cloud: openai_compat (works with Inception, OpenAI, Groq, etc.)
THINKBOX_DEFAULT_PROVIDER=ollama

# Ollama Settings (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI-compatible Settings (if using openai_compat provider)
# Works with: OpenAI, Inception (Mercury 2), Groq, Together, vLLM, etc.
# THINKBOX_DEFAULT_PROVIDER=openai_compat
# THINKBOX_OPENAI_COMPAT_API_KEY=REDACTED_API_KEY
# THINKBOX_OPENAI_COMPAT_BASE_URL=https://api.inception.ai/v1
# THINKBOX_DEFAULT_MODEL=mercury-2

# Inception API (Mercury 2) — ~1M tokens available
# Get key at: https://inception.ai
# THINKBOX_DEFAULT_PROVIDER=openai_compat
# THINKBOX_OPENAI_COMPAT_API_KEY=REDACTED_API_KEY
# THINKBOX_OPENAI_COMPAT_BASE_URL=https://api.inception.ai/v1
# THINKBOX_DEFAULT_MODEL=mercury-2

# Memory
THINKBOX_MEMORY_DB_PATH=./thinkbox_memory.db

# Server
THINKBOX_PROJECT_ROOT=.
