# Think Box AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Provider Settings ───────────────────────────────────────
# ollama (local, default) | openai_compat | inception
# See docs/guides/local_think_box.md; verify with: python3 -m thinkbox.cli model check
THINKBOX_DEFAULT_PROVIDER=openai_compat
THINKBOX_DEFAULT_MODEL=gpt-4o-mini
THINKBOX_OPENAI_COMPAT_API_KEY=sk-your-key-here
THINKBOX_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# Ollama only (defaults to http://localhost:11434)
THINKBOX_OLLAMA_BASE_URL=
# Embeddings for Upstash Vector (must be 1536-dim; default text-embedding-3-small)
THINKBOX_EMBED_MODEL=

# ─── Security ─────────────────────────────────────────────────
# Generate a key: python3 -c "import secrets; print('tb_' + secrets.token_urlsafe(32))"
THINKBOX_API_KEY=tb-your-api-key-here
THINKBOX_API_KEYS=tb-key1,tb-key2
THINKBOX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
THINKBOX_RATE_LIMIT=100

# ─── Server ───────────────────────────────────────────────────
THINKBOX_PROJECT_ROOT=.
THINKBOX_LOG_LEVEL=INFO

# ─── Inception API (Mercury-2) ────────────────────────────────
# Used when THINKBOX_DEFAULT_PROVIDER=inception (host: api.inceptionlabs.ai)
INCEPTION_API_KEY=

# ─── Cursor SDK (optional) ────────────────────────────────────
CURSOR_API_KEY=
UPCLOUD_API_KEY=ucat_your_key_here

# ─── UpCloud governed SSH execution (substrate `upcloud-ssh`) ─
# One authorized worker only. Never commit a live key or live values.
#   UPCLOUD_SERVER_IP        worker-02 address, e.g. 209.50.51.174
#   UPCLOUD_SSH_USER         prefer a non-root user; the default `root` is a
#                            development default, NOT the recommended production
#                            configuration
#   UPCLOUD_SSH_KEY_PATH     path to an existing private key file (never read by
#                            Python, only passed to ssh(1))
#   UPCLOUD_SSH_HARDENED     1/true/yes/on to pin the host key. Hardened mode
#                            requires UPCLOUD_SSH_KNOWN_HOSTS and fails closed
#                            without it; it never uses accept-new.
#   UPCLOUD_SSH_KNOWN_HOSTS  path to a trusted known_hosts file
UPCLOUD_SERVER_IP=
UPCLOUD_SSH_USER=
UPCLOUD_SSH_KEY_PATH=
UPCLOUD_SSH_HARDENED=
UPCLOUD_SSH_KNOWN_HOSTS=

# ─── Upstash Box remote execution (adapter contract) ──────────
# Required by thinkbox/execution_adapter.py. Empty here on purpose.
# Do not put live tokens in this file.
UPSTASH_PUBLIC_BOX_URL=
UPSTASH_PUBLIC_BOX_TOKEN=

# ─── Algorand / HERMES agent (see docs/HERMES_ALGORAND.md) ────
# Read-only lookups (status/account/asset/application/transaction) use public
# AlgoNode endpoints by default — no key needed, nothing below is required for
# HERMES. Only set these to point at your own node/indexer instead.
ALGORAND_ALGOD_URL_TESTNET=
ALGORAND_ALGOD_URL_MAINNET=
ALGORAND_INDEXER_URL_TESTNET=
ALGORAND_INDEXER_URL_MAINNET=

# Testnet-only transaction signing (separate from HERMES, which never signs).
# Testnet ALGO has no monetary value (get some from https://bank.testnet.algorand.network).
# NEVER put a mainnet mnemonic here or anywhere in this repo. Leaving this unset
# disables signing entirely — the tool does not exist until both this mnemonic
# and KUDBEE_ENABLE_ALGORAND_TESTNET_SIGNING=true are set.
KUDBEE_ENABLE_ALGORAND_TESTNET_SIGNING=
KUDBEE_ALGORAND_TESTNET_MNEMONIC=